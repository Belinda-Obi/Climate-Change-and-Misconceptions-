    <dashboard name='Slide Notes ' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Reality Of Willingness to Take Climate Actions </run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='5187' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='6017' />
            <zone h='82676' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='16494'>
              <flipboard active-id='5' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Reality' captured-sheet='Reality' id='2' />
                  <story-point caption='Percption ' captured-sheet='Perception ' id='3' />
                  <story-point caption='Gap' captured-sheet='The Gap' id='5' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='28320' hidden='true' id='6' story-point-id='2' type-v2='text' w='33268' x='72441' y='50311'>
          <formatted-text>
            <run bold='true' fontsize='16'>The Reality :</run>
            <run bold='true'>Æ </run>
            <run>This shows the &quot;Actual Willingess to give &quot;.
</run>
            <run bold='true' fontsize='16'> Caption</run>
            <run bold='true'> &quot;</run>
            <run>70%+ of people globally say they are willing to contribute to climate change &quot;. </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='40456' hidden='true' id='7' story-point-id='3' type-v2='text' w='33268' x='67520' y='31743'>
          <formatted-text>
            <run bold='true' fontsize='16'>The Pessimism/ Perception :</run>
            <run bold='true'>Æ </run>
            <run>This reports the map of  &quot; Predicted Willingness &quot;.
</run>
            <run bold='true' fontsize='16'>Caption</run>
            <run bold='true'> : </run>
            <run>However , when asked about the others, people across almost every country underestimates their neigbours. </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='32469' id='8' story-point-id='5' type-v2='text' w='35630' x='71949' y='42012'>
          <formatted-text>
            <run bold='true' fontsize='16'>The Gap : </run>
            <run>This shows the calculated &quot;Perception Gap &quot;. 

</run>
            <run bold='true' fontsize='16'>Caption : </run>
            <run>This &apos;social mirage&apos;creates a barrier to action because we feel like we are acting alone . This final map shows the difference , highlighting counteries where underestimation is most extreme .</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{DA611A01-D0BA-4AAD-9EE7-E2C65FF6126F}' />
    </dashboard>
